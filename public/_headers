/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The landing page is open to search engines. The Desk is an app with nothing to read until someone uses it, and the
# API is not a page, so those two stay out of search results.
/app/
  X-Robots-Tag: noindex, follow
/app/*
  X-Robots-Tag: noindex, follow
/api/*
  X-Robots-Tag: noindex, nofollow

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400
